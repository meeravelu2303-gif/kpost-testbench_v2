# Copy to `.env` (shared defaults) or `.env.<TEST_ENV>` (per environment) and fill in.
# Precedence: real environment variables > .env.<TEST_ENV> > .env
# Never commit real credentials.

# local | dev | qa | staging | production
TEST_ENV=local

# ---- Application under test
# UI base URL
BASE_URL=https://playwright.dev
# API base URL. Empty + TEST_ENV=local => the bundled mock API is started and used.
API_BASE_URL=
# Force the bundled mock API on/off (default: on for local without API_BASE_URL)
MOCK_API=
MOCK_API_PORT=4010

# ---- Authentication (API)
# JSON array: [{"key":"admin","role":"ADMIN","username":"...","password":"..."},
#              {"key":"company-admin","role":"COMPANY_ADMIN","tenantId":"<company-id>",...}]
# Roles: SUPER_ADMIN | ADMIN | COMPANY_ADMIN | USER. Add a second-tenant principal to enable
# cross-resource checks, and a "login-probe" principal for login endpoint validation.
AUTH_PRINCIPALS=
# A genuinely expired token for this environment (enables the expired-token validator)
EXPIRED_TOKEN=
# Company that test data is created in
TEST_COMPANY_ID=

# ---- Authentication (UI setup project)
APP_USERNAME=
APP_PASSWORD=

# ---- Database validation
DB_ENABLED=
DB_CONNECTION_STRING=

# ---- Validation policy
# SMOKE | REGRESSION | SECURITY | FULL
VALIDATION_PROFILE=REGRESSION
# Must be true to run data-mutating tests when TEST_ENV=production
ALLOW_DESTRUCTIVE_TESTS=false

# ---- Runner (empty = sensible defaults for local vs CI)
HEADLESS=true
WORKERS=
RETRIES=
# debug | info | warn | error
LOG_LEVEL=info
# pretty | json
LOG_FORMAT=pretty
BUILD_ID=
