# Copy to `.env` (shared defaults) or `.env.<TEST_ENV>` (per environment) and fill in.
# Precedence: real environment variables > .env.<TEST_ENV> > .env
# Never commit real credentials.

# local | dev | qa | staging | production
TEST_ENV=local

# ---- Application under test
#
# THE TARGET IS THE LIVE APPLICATION. The old dev host (192.168.0.66) has been removed on the
# owner's instruction: its code was changed in ways live's was not, so findings against it could
# not be trusted. See CLAUDE.md section 8.
#
# Fill these with the live hostnames. Leave them EMPTY rather than guessing - an endpoint pointed
# at the wrong host reports 404s that look like defects, which is a day already lost once.
#
# UI base URL (the live front end)
BASE_URL=
# API base URL. Empty + TEST_ENV=local => the bundled mock API is started and used.
API_BASE_URL=
# KPost is one product built from separately deployed modules. Each suite targets its own host;
# unset falls back to API_BASE_URL. See src/config/ownership.config.ts for who owns each module.
KPOST_API_BASE_URL=
ADMIN_API_BASE_URL=
KMAIL_API_BASE_URL=
# Force the bundled mock API on/off (default: on for local without API_BASE_URL)
MOCK_API=
MOCK_API_PORT=4010

# ---- Authentication (API)
# JSON array: [{"key":"admin","role":"ADMIN","username":"...","password":"..."},
#              {"key":"company-admin","role":"COMPANY_ADMIN","tenantId":"<company-id>",...}]
# Roles: SUPER_ADMIN | ADMIN | COMPANY_ADMIN | USER. Add a second-tenant principal to enable
# cross-resource checks, and a "login-probe" principal for login endpoint validation.
AUTH_PRINCIPALS=
# A genuinely expired token for this environment (enables the expired-token validator)
EXPIRED_TOKEN=
# Company that test data is created in
TEST_COMPANY_ID=

# ---- Authentication (UI setup project)
APP_USERNAME=
APP_PASSWORD=

# ---- Database validation (MySQL)
#
# KPost and KMail run against a TEST database (KPOST_QA). The Admin module runs against a LIVE
# PRODUCTION database and is configured separately, further down.
#
# Unset, the DB layer follows what is reachable: the mock's store under MOCK_API=true, MySQL when
# DB_HOST and DB_NAME are set, otherwise nothing. With nothing reachable the DB validations report
# SKIPPED - they never pass without having queried, because whether a write actually landed is
# exactly what the API response cannot prove on its own.
DB_ENABLED=
DB_TYPE=mysql
# A JDBC URL (jdbc:mysql://host:3306) is accepted and reduced to its host. A port inside the URL
# that disagrees with DB_PORT throws rather than picking a winner.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
# In MySQL the database IS the schema, so table names resolve inside this one.
DB_NAME=
# Must exceed thresholds.concurrency.maxRequests, or the bench's own pool becomes the bottleneck
# and a query waiting for a connection reads as a slow database.
DB_POOL_SIZE=10
DB_STATEMENT_TIMEOUT_MS=5000
#
# TLS. On by default; a server with --require_secure_transport=ON refuses plaintext outright.
# Point DB_SSL_CA at the server's CA (PEM) when it presents a private or self-signed certificate -
# supplying a CA turns verification on automatically.
DB_SSL=true
DB_SSL_CA=
# Leave this on. Off keeps traffic encrypted but stops authenticating the server, so anything in
# between can present its own certificate and read the credentials during the handshake.
DB_SSL_REJECT_UNAUTHORIZED=true
#
# Permit non-SELECT SQL on the KPost/KMail TEST database only. Default deny, and deliberately NOT
# covered by ALLOW_DESTRUCTIVE_TESTS: that flag governs requests the application handles, where its
# own validation, permissions and audit trail still apply, while a direct SQL write bypasses all
# three. It has NO effect on the Admin database - see below.
DB_ALLOW_WRITES=false

# ---- Admin module database (LIVE PRODUCTION - read-only, always)
#
# Separate variables on purpose: pointing Admin at the test database, or the KPost suites at the
# live one, must take a deliberate edit rather than an inherited default.
#
# Writes to this connection are refused in code (WRITE_BANNED_SUITES in src/config/database.config.ts)
# and DB_ALLOW_WRITES does not apply to it, so no combination of these variables lets the bench
# write to live Admin data. Left blank, Admin DB validations report SKIPPED with the reason.
ADMIN_DB_HOST=
ADMIN_DB_PORT=3306
ADMIN_DB_USER=
ADMIN_DB_PASSWORD=
ADMIN_DB_NAME=
ADMIN_DB_SSL=true
ADMIN_DB_SSL_CA=
ADMIN_DB_SSL_REJECT_UNAUTHORIZED=true

# ---- Validation policy
# SMOKE | REGRESSION | SECURITY | FULL
VALIDATION_PROFILE=REGRESSION
#
# Enables `external` (real SMS/email) and `global` (shared state) endpoints OFF production.
#
# It grants NOTHING when TEST_ENV=production. On the live application the endpoints it would
# unlock are exactly the ones that must never run unattended - forgotPasswordUpdate,
# removeCompanyLogo, updateFlutterAppVersion - and an environment variable is far too easy to
# inherit from a shell or a stale .env. See src/validation-engine/production-guard.ts.
ALLOW_DESTRUCTIVE_TESTS=false

# ---- Live-application safety (active only when TEST_ENV=production)
#
# Three independent controls, none of which can be switched off by configuration:
#
#  1. Endpoint allowlist - only definitions marked `productionSafe: true` run at all.
#     src/api/registry/endpoint-definition.ts
#  2. Validator allowlist - every validator that mutates and re-sends a request is excluded.
#     src/validation-engine/production-validators.ts
#  3. QA-identifier guard - a request naming any identifier not in the QA_* set below is
#     refused before it is sent. src/validation-engine/qa-identifier-guard.ts
#
# Control 3 is the one that matters most, because several KPost endpoints act on the id in the
# PAYLOAD rather than on the caller - so logging in as a QA account does not confine them.
#
# Also set WORKERS=1 in the runner section below before any live run.

# ---- Bugzilla (automatic bug filing; see docs/bug-filing.md)
# Unset URL or key => the reporter says so and files nothing.
BUGZILLA_URL=http://192.168.0.50/rest
BUGZILLA_API_KEY=
# Filing cannot be undone (Bugzilla has no delete), so dry run is the default.
BUGZILLA_DRY_RUN=true
# Products, components and assignees are NOT configured here — they follow the module that
# found the defect. See src/config/ownership.config.ts.
# CRITICAL | HIGH | MEDIUM | LOW — lowest severity that may become a ticket
BUGZILLA_MIN_SEVERITY=MEDIUM
# Staged rollout: file at most N bugs per run (0 = no cap)
BUGZILLA_MAX_FILE=0
BUGZILLA_FILE_UI_FAILURES=true

# ---- Runner (empty = sensible defaults for local vs CI)
HEADLESS=true
# SET THIS TO 1 FOR ANY LIVE RUN. Four concurrent logins already answer 500 and the probes already
# trip rate limits, so parallel workers load a path that is known to be fragile - and a throttle
# that is per-IP rather than per-account would block real users.
WORKERS=
RETRIES=
# debug | info | warn | error
LOG_LEVEL=info
# pretty | json
LOG_FORMAT=pretty
BUILD_ID=
