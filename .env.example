# KPost Test Bench — environment template.
#
# Copy to `.env` and fill in. Precedence: real environment variables > .env.<TEST_ENV> > .env.
# Never commit `.env`: it holds the Bugzilla key, the database passwords and the account passwords.
#
# This file lists EVERY key the bench reads, in the order the real file keeps them. A key the code
# reads but this file does not name fails `tests/framework/env-template.spec.ts`, so a fresh
# checkout can never be missing something silently. `npm run preflight` checks the filled-in `.env`
# before a live run.

# ---- Bugzilla (automatic bug filing; see docs/guides/bug-filing.md)
# Unset URL or key => the reporter says so and files nothing.
BUGZILLA_URL=
BUGZILLA_API_KEY=
# Filing cannot be undone (Bugzilla has no delete), so dry run is the default; every `:file`
# command sets it to false explicitly.
BUGZILLA_DRY_RUN=true
# Staged rollout: file at most N bugs per run (0 = no cap)
BUGZILLA_MAX_FILE=0
# CRITICAL | HIGH | MEDIUM | LOW — lowest severity that may become a ticket
BUGZILLA_MIN_SEVERITY=MEDIUM
BUGZILLA_FILE_UI_FAILURES=true
BUGZILLA_FILE_ACCESSIBILITY=true
# Set by the commands, listed here so nothing the code reads is undocumented:
# BUGZILLA_AUTO_RESOLVE=true    close a bug whose own check passed cleanly this run
# BUGZILLA_RESOLVE_ONLY=false   status pass only (`product:kpost-api:verify`): comment/close, file nothing new

# ---- Target hosts — the TEST deployment, and only that
# The bench tests the KPost TEST environment: test.kpostindia.com, testingapi.kpostindia.com,
# testkmail.kpostindia.com, the Admin test box. It never targets the live application
# (account.kpostindia.com / devapi2 / kmail5 / adminmodule.kpostindia.com). TEST_ENV=production is the
# name of the SAFETY MODE (endpoint allowlist, validator allowlist, QA-identifier guard), not a host
# choice — never change it to make something run.
TEST_ENV=production
# KPost is one product built from separately deployed modules; each suite targets its own host and
# an unset one falls back to API_BASE_URL. Owners per module: src/config/ownership.config.ts.
API_BASE_URL=
KPOST_API_BASE_URL=https://testingapi.kpostindia.com
# The Admin/HR-Setup API test box (an internal address the owner gives you; the live service is
# adminmodule.kpostindia.com and is never used).
ADMIN_API_BASE_URL=
KMAIL_API_BASE_URL=https://testkmail.kpostindia.com
# KMail's path prefix. Leave unset: it follows KMAIL_API_BASE_URL (/testkmail/v2 on testkmail,
# /v2 on a KMail server reached directly, e.g. http://192.168.0.100:9081). Set it only to override.
# KMAIL_PATH_PREFIX=
# The test front end and the Admin/HR-Setup UI (a separate SPA).
BASE_URL=https://test.kpostindia.com
ADMIN_UI_BASE_URL=http://192.168.10.22:3001

# ---- Run safety
# SET THIS TO 1 FOR ANY LIVE RUN (the named commands also pass --workers=1). Four concurrent logins
# already answer 500 and the probes already trip rate limits; a per-IP throttle would block real users.
WORKERS=1
# Enables `external` (real SMS/email) and `global` (shared state) endpoints OFF production. It grants
# NOTHING when TEST_ENV=production: the endpoints it would unlock are exactly the ones that must never
# run unattended. See src/validation-engine/production-guard.ts.
ALLOW_DESTRUCTIVE_TESTS=false
# The server is shared with live users: concurrency and performance probes stay off (owner directive).
CONCURRENCY_PROBES=false
# Uploads land in the LIVE AWS S3 bucket: no file larger than this (bytes) is ever sent (owner, 2026-10-31).
UPLOAD_MAX_BYTES=65536
# Also apply the backend-source response schemas no live response has confirmed yet, to trial them.
# Never on a filing run. See src/api/contract/source-contract.ts.
# SOURCE_CONTRACT_TRIAL=false
# Set by the commands (listed for completeness): VALIDATION_PROFILE (SMOKE|REGRESSION|SECURITY|FULL),
# TEST_DB_MODE (full matrix on the disposable test DB), WRITE_FUZZ (fuzz writes; needs TEST_DB_MODE),
# QATEST_ONLY (re-point QA_* to the qatest accounts), and the *_LIFECYCLE / *_UI_LIFECYCLE gates.
# VALIDATION_PROFILE=REGRESSION
# TEST_DB_MODE=false
# WRITE_FUZZ=false
# QATEST_ONLY=true
# Admin API write flows on the QA companies (org structure, role posting, field sweeps).
# ADMIN_LIFECYCLE=false
# The target is the QA test server: self-cleaning flows may make shared-state (`global`) writes, each
# call authorized on its own. Needs TEST_DB_MODE; refused if any host is live; never SMS/e-mail.
# GLOBAL_LIFECYCLE=false
# Role posting writes create a KPost (testingapi) + a LIVE KSMACC account per posting; QA companies only.
# ADMIN_ROLE_POSTING_LIVE=false
# Opt-in Admin extras: oversized input (#13258 open; delayed writes outlive clean-up), more latency cycles,
# the one-time staff-employee setup, and the leftovers tool (list | delete).
# ADMIN_OVERSIZE=false
# OVERSIZE_CHARS=100000
# LATENCY_ROLE_CYCLES=3
# ADMIN_CREATE_STAFF=false
# ADMIN_QA_CLEANUP=list

# ---- qatest1-6: the ONLY accounts the KPost API, KMail and UI commands log in as (QATEST_ONLY=true)
#   qatest1  primary / owner          qatest2  counterparty / stranger
#   qatest3  group / Cc party         qatest4  group / Cc party
#   qatest5  sacrificial write target qatest6  forgot-password / lockout spare
# Created by scripts/provision-test-accounts.cjs; the ids are not secret, the shared password is.
QATEST1_KPOST_ID=qatest1@kpostindia.com
QATEST2_KPOST_ID=qatest2@kpostindia.com
QATEST3_KPOST_ID=qatest3@kpostindia.com
QATEST4_KPOST_ID=qatest4@kpostindia.com
QATEST5_KPOST_ID=qatest5@kpostindia.com
QATEST6_KPOST_ID=qatest6@kpostindia.com
# qatest7-8: mobile (Patrol) only; never mapped to a Playwright role
QATEST7_KPOST_ID=qatest7@kpostindia.com
QATEST8_KPOST_ID=qatest8@kpostindia.com
# The 4-digit app access code the phone sets for qatest7 (mobile tests only)
QATEST7_ACCESS_CODE=
QATEST_SHARED_PASSWORD=
# Mailbox that receives the signup e-mail OTP during provisioning; {id} becomes qatest1.. (no default)
# QATEST_OTP_MAILBOX_TEMPLATE=

# ---- Shared QA accounts — the Admin commands (business/company-admin logins) and the legacy
# identity set. With QATEST_ONLY=true the personal ones are overridden by qatest1-6 at startup.
QA_KPOST_ID=
QA_PASSWORD=
QA_USER_TYPE=PERSONAL
QA_COUNTRY_ID=1
QA_MOBILE_EXISTS=
QA_VICTIM_KPOST_ID=
QA_PERSONAL_3_KPOST_ID=
QA_PERSONAL_4_KPOST_ID=
QA_PERSONAL_5_KPOST_ID=
QA_PERSONAL_6_KPOST_ID=
# forgotPassword rewrites an account's password: its own spare account, never the primary.
QA_FORGOT_PASSWORD_KPOST_ID=
# Negative-login account: the wrong-password / disabled-account specs use it, so the primary account
# never collects failed-login strikes. Unset → those specs skip with a reason.
QA_NEG_KPOST_ID=
QA_NEG_PASSWORD=
# Business tiers (Small / Medium / Large) and the Medium company's members — Admin, user-management and
# the authorization validators. KEPT under QATEST_ONLY=true (they have no qatest stand-in).
QA_BUSINESS_S_KPOST_ID=
QA_BUSINESS_M_KPOST_ID=
QA_BUSINESS_L_KPOST_ID=
# Their password. Leave unset to use QA_PASSWORD; under QATEST_ONLY the switch captures QA_PASSWORD
# here before re-pointing it at QATEST_SHARED_PASSWORD, so the business accounts keep logging in.
QA_BUSINESS_PASSWORD=
QA_BUSINESS_M_USER_1_KPOST_ID=
QA_BUSINESS_M_USER_2_KPOST_ID=
QA_BUSINESS_M_USER_3_KPOST_ID=
QA_BUSINESS_M_USER_4_KPOST_ID=
QA_BUSINESS_M_USER_1_MOBILE=
QA_BUSINESS_M_USER_2_MOBILE=
QA_BUSINESS_M_USER_3_MOBILE=
QA_BUSINESS_M_USER_4_MOBILE=
QA_BUSINESS_M_MOBILE=
QA_COMPANY_NAME=
QA_BUSINESS_S_COMPANY_ID=
QA_BUSINESS_M_COMPANY_ID=
QA_BUSINESS_L_COMPANY_ID=
# Identifiers that must NOT exist — the "not found" paths and the enumeration probes.
QA_KPOST_ID_ABSENT=
QA_MOBILE_ABSENT=
QA_COMPANY_NAME_ABSENT=QA Bench Nonexistent Co 9f2a7c
# Optional extras read by src/config/test-data.config.ts (schema defaults apply when blank).
# QA_ADMIN_KPOST_ID=   QA_ADMIN_PASSWORD=   QA_ADMIN_USER_TYPE=   QA_BUSINESS_RECEIVER_KPOST_ID=
# QA_COMPANY_ID=   QA_DOMAIN=   QA_UNIQUE_NAME=   QA_PINCODE=   QA_STATE_ID=   QA_REGION_ID=
# Admin role-posting test employee (ADMIN_ROLE_POSTING_LIVE): throwaway mobile + email, trusted by the
# QA-identifier guard only when set here. e.g. QA_ROLE_EMPLOYEE_MOBILE=9000099901  QA_ROLE_EMPLOYEE_EMAIL=qa.role.employee@example.com
# QA_ROLE_EMPLOYEE_MOBILE=
# QA_ROLE_EMPLOYEE_EMAIL=
# QA_OTP_MOBILE=   QA_OTP_EMAIL=   QA_INVALID_OTP=   QA_PRODUCT_OBJECT_ID=   QA_MODULE_ID=

# ---- Reserved signup identities (a signup cannot be deleted — these exist only to be signed up)
QA_SIGNUP_KPOST_ID=
QA_SIGNUP_MOBILE=
QA_BUSINESS_SIGNUP_KPOST_ID=
QA_BUSINESS_SIGNUP_MOBILE=
QA_BUSINESS_SIGNUP_COMPANY_NAME=
QA_BUSINESS_SIGNUP_UNIQUE_NAME=
QA_SIGNUP_UI_KPOST_ID_LOCAL=
QA_SIGNUP_UI_MOBILE=
QA_SIGNUP_MOBILE_VIEWPORT_UI_KPOST_ID_LOCAL=
QA_SIGNUP_MOBILE_VIEWPORT_UI_MOBILE=
QA_SIGNUP_BUSINESS_UI_MOBILE=
QA_SIGNUP_BUSINESS_COMPANY_NAME=
QA_SIGNUP_BUSINESS_UNIQUE_NAME=
QA_SIGNUP_BUSINESS_DESIGNATION_ID=
QA_SIGNUP_MEDIUM_BUSINESS_UI_MOBILE=
QA_SIGNUP_MEDIUM_BUSINESS_COMPANY_NAME=
QA_SIGNUP_MEDIUM_BUSINESS_UNIQUE_NAME=
QA_SIGNUP_MEDIUM_BUSINESS_DESIGNATION_ID=
QA_SIGNUP_LARGE_BUSINESS_UI_MOBILE=
QA_SIGNUP_LARGE_BUSINESS_COMPANY_NAME=
QA_SIGNUP_LARGE_BUSINESS_UNIQUE_NAME=
QA_SIGNUP_LARGE_BUSINESS_DESIGNATION_ID=

# ---- OTP
# The signup MOBILE OTP is a test gateway on the test host (the bypass code below validates); the
# signup e-mail OTP and the forgot-password OTP are REAL, so those flows are capped to one call.
# The SMS/OTP kill-switch is otherwise absolute: no flag sends an OTP to a real person.
OTP_TEST_GATEWAY=true
QA_BYPASS_OTP=123456

# ---- Database — KPOST_QA is the TEST database (writes allowed); the Admin DB is LIVE (read-only in code)
# Unset, the DB layer follows what is reachable: MySQL when DB_HOST and DB_NAME are set, otherwise
# nothing. With nothing reachable the DB validations report SKIPPED — they never pass without having
# queried, because whether a write landed is exactly what the API response cannot prove on its own.
DB_ENABLED=true
# A JDBC URL (jdbc:mysql://host:3306) is accepted and reduced to its host.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
# In MySQL the database IS the schema, so table names resolve inside this one.
DB_NAME=
# Must exceed thresholds.concurrency.maxRequests, or the bench's own pool becomes the bottleneck.
DB_POOL_SIZE=10
DB_STATEMENT_TIMEOUT_MS=5000
# Permit non-SELECT SQL on the KPost/KMail TEST database only. Default deny, and deliberately NOT
# covered by ALLOW_DESTRUCTIVE_TESTS. It has NO effect on the Admin database.
DB_ALLOW_WRITES=false
# TLS. On by default. Point DB_SSL_CA at the server's CA (PEM) when it presents a private certificate;
# leave verification on — off keeps traffic encrypted but stops authenticating the server.
DB_SSL=true
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=true

# ---- Admin module database (LIVE PRODUCTION — read-only, always)
# Separate variables on purpose. Writes to this connection are refused in code
# (WRITE_BANNED_SUITES in src/config/database.config.ts) and DB_ALLOW_WRITES does not apply to it.
# Left blank, Admin DB validations report SKIPPED with the reason.
ADMIN_DB_HOST=
ADMIN_DB_PORT=3306
ADMIN_DB_USER=
ADMIN_DB_PASSWORD=
ADMIN_DB_NAME=
ADMIN_DB_SSL=true
ADMIN_DB_SSL_CA=
ADMIN_DB_SSL_REJECT_UNAUTHORIZED=true
# The Admin backend actually stores its records in MongoDB (database admin_enterprise). Read-only
# reader for the Admin cross-layer checks (src/database/admin-mongo.ts: find/findOne only, no write
# method exists). e.g. mongodb://192.168.11.11:27017. Blank → those checks report SKIPPED.
ADMIN_MONGO_URI=
ADMIN_MONGO_DB=admin_enterprise

# ---- Feature flags
# KMail accepted every valid token again from 2026-10-09; keep true unless the regression returns
# (tests/kmail-api/auth-regression.spec.ts proves it either way).
KMAIL_AUTH_FIXED=true

# ---- Optional: authentication extras and runner settings (schema defaults apply when blank)
# A JSON array of extra principals for the generic validators; the bench normally logs in itself.
AUTH_PRINCIPALS=
# A genuinely expired token for the expired-token validator. Normally blank: the bench keeps the
# tokens it used (.auth/token-history.json) and picks an expired one itself.
EXPIRED_TOKEN=
TEST_COMPANY_ID=
# UI setup-project login (the setup project uses the qatest primary when these are blank).
APP_USERNAME=
APP_PASSWORD=
HEADLESS=true
RETRIES=
# debug | info | warn | error · pretty | json
LOG_LEVEL=info
LOG_FORMAT=pretty
BUILD_ID=
