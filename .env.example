# Copy to `.env` (shared defaults) or `.env.<TEST_ENV>` (per environment) and fill in.
# Precedence: real environment variables > .env.<TEST_ENV> > .env
# Never commit real credentials. `.env` and `.env.*` (except this file) are git-ignored.
#
# Every variable the bench reads is listed here — a framework guard
# (tests/framework/bench-hardening.spec.ts) fails when a new one is added to the code but not here.
# Run switches (VALIDATION_PROFILE, TEST_DB_MODE, the *_LIFECYCLE gates …) are normally set by the
# npm commands in docs/COMMANDS.md, not in this file.

# local | dev | qa | staging | production
# NOTE: `production` arms the live-safety controls (endpoint + validator allowlists). The current
# target is the disposable TEST deployment, which still runs with TEST_ENV=production so those
# controls stay on (see CLAUDE.md §8). The QA-identifier guard applies to every real host regardless.
TEST_ENV=local

# ---- Application under test
# Hosts per module (each suite targets its own). Current test hosts, for reference:
#   KPOST_API_BASE_URL=https://testingapi.kpostindia.com
#   KMAIL_API_BASE_URL=https://testkmail.kpostindia.com      (origin only; see KMAIL_PATH_PREFIX)
#   ADMIN_API_BASE_URL=http://192.168.0.38:9595
#   BASE_URL=https://test.kpostindia.com/
# Leave a host EMPTY rather than guessing — a wrong host reports 404s that look like defects.
BASE_URL=
# The Admin/HR-Setup UI (a separate SPA, SSO'd by the KPost token)
ADMIN_UI_BASE_URL=
# API base URL. Empty + TEST_ENV=local => the bundled mock API is started and used.
API_BASE_URL=
KPOST_API_BASE_URL=
ADMIN_API_BASE_URL=
KMAIL_API_BASE_URL=
# Path KMail serves under: prod /kmail5/v2, test /testkmail/v2
KMAIL_PATH_PREFIX=/kmail5/v2
# Force the bundled mock API on/off (default: on for local without API_BASE_URL)
MOCK_API=
MOCK_API_PORT=4010

# ---- Mock-mode authentication (the bundled mock server only; the real hosts use the QA_* accounts)
# JSON array: [{"key":"admin","role":"ADMIN","username":"...","password":"..."}]
AUTH_PRINCIPALS=
# A genuinely expired token for this environment (enables the expired-token validator)
EXPIRED_TOKEN=
TEST_COMPANY_ID=
APP_USERNAME=
APP_PASSWORD=

# ---- QA accounts and test data (src/config/test-data.config.ts)
# Only values EXPLICITLY set here are allowlisted by the QA-identifier guard — a schema default is
# never treated as ours. PERSONAL accounts can only be created on @kpostindia.com.
QA_KPOST_ID=
QA_PASSWORD=
QA_USER_TYPE=PERSONAL
QA_COUNTRY_ID=1
QA_VICTIM_KPOST_ID=
QA_PERSONAL_3_KPOST_ID=
QA_PERSONAL_4_KPOST_ID=
QA_PERSONAL_5_KPOST_ID=
QA_PERSONAL_6_KPOST_ID=
QA_BUSINESS_RECEIVER_KPOST_ID=
QA_BUSINESS_S_KPOST_ID=
QA_BUSINESS_M_KPOST_ID=
QA_BUSINESS_L_KPOST_ID=
QA_BUSINESS_S_COMPANY_ID=
QA_BUSINESS_M_COMPANY_ID=
QA_BUSINESS_L_COMPANY_ID=
QA_BUSINESS_M_USER_1_KPOST_ID=
QA_BUSINESS_M_USER_2_KPOST_ID=
QA_BUSINESS_M_MOBILE=
QA_ADMIN_KPOST_ID=
QA_ADMIN_PASSWORD=
QA_ADMIN_USER_TYPE=
QA_MOBILE_EXISTS=
QA_COMPANY_ID=
QA_COMPANY_NAME=
QA_UNIQUE_NAME=
QA_DOMAIN=
# Values that must match NOTHING (enumeration probes); safe to allowlist by construction
QA_KPOST_ID_ABSENT=
QA_MOBILE_ABSENT=
QA_COMPANY_NAME_ABSENT=
# Reserved registration identity (OTP test gateway + disposable DB only)
QA_SIGNUP_KPOST_ID=
QA_SIGNUP_MOBILE=
QA_FORGOT_PASSWORD_KPOST_ID=
# Reference data
QA_STATE_ID=
QA_REGION_ID=
QA_PINCODE=
QA_PRODUCT_OBJECT_ID=
QA_MODULE_ID=
# OTP
QA_OTP_MOBILE=
QA_OTP_EMAIL=
QA_INVALID_OTP=
QA_BYPASS_OTP=

# ---- Database validation (Phase 6 — no real adapter yet; only the bundled mock is supported)
DB_ENABLED=
DB_CONNECTION_STRING=

# ---- Validation policy
# SMOKE | REGRESSION | SECURITY | FULL. FULL = REGRESSION + injection/XSS/rate-limit. The API npm
# commands set FULL explicitly; validators outside the active profile are reported as SKIPPED.
VALIDATION_PROFILE=REGRESSION
# Enables `external` (real SMS/email) and `global` (shared state) endpoints OFF production.
# It grants NOTHING when TEST_ENV=production. See src/validation-engine/production-guard.ts.
ALLOW_DESTRUCTIVE_TESTS=false
# The target is a disposable TEST database: the full matrix may run on READ endpoints.
TEST_DB_MODE=false
# Fuzz `data` WRITE endpoints too (persists junk — disposable DB only; needs TEST_DB_MODE)
WRITE_FUZZ=false
# The OTP subsystem is a TEST GATEWAY (no real SMS; 123456 validates). Needs TEST_DB_MODE.
OTP_TEST_GATEWAY=false

# ---- Gated write flows (each opens one module's self-cleaning lifecycle; set by the npm commands)
ADMIN_LIFECYCLE=false
# Mints real, undeletable KPost + KSMACC accounts — owner-authorized only
ADMIN_ROLE_POSTING_LIVE=false
AWS_LIFECYCLE=false
CONTACTS_LIFECYCLE=false
GROUP_LIFECYCLE=false
KALL_LIFECYCLE=false
KATCHUP_LIFECYCLE=false
KDIARY_LIFECYCLE=false
KMAIL_LIFECYCLE=false
KOS_LIFECYCLE=false
# Calls a real, BILLED AI service — owner-authorized only
KOS_AI_LIVE=false
PROFILE_LIFECYCLE=false
SETTINGS_LIFECYCLE=false
ADMIN_UI_LIFECYCLE=false
BUSINESS_UI_LIFECYCLE=false
CONTACTS_UI_LIFECYCLE=false
GROUP_UI_LIFECYCLE=false
KALL_UI_LIFECYCLE=false
KATCHUP_UI_LIFECYCLE=false
KDIARY_UI_LIFECYCLE=false
KMAIL_UI_LIFECYCLE=false
LOGIN_UI_LIFECYCLE=false
PROFILE_UI_LIFECYCLE=false
SETTINGS_UI_LIFECYCLE=false
VISUAL_REGRESSION=false

# ---- Bugzilla (automatic bug filing; see docs/bug-filing.md)
# Unset URL or key => the reporter says so and files nothing.
BUGZILLA_URL=http://192.168.0.50/rest
BUGZILLA_API_KEY=
# Filing cannot be undone. A `false` here is IGNORED: filing is armed only by the command
# (`npm run <suite>:file`) or CI, never by a file — so an ad-hoc run can never file by accident.
BUGZILLA_DRY_RUN=true
# CRITICAL | HIGH | MEDIUM | LOW — lowest severity that may become a ticket
BUGZILLA_MIN_SEVERITY=MEDIUM
# Staged rollout: file at most N bugs per run (0 = no cap)
BUGZILLA_MAX_FILE=0
BUGZILLA_FILE_UI_FAILURES=true
# Close bench-filed bugs this run verified fixed (filing runs only)
BUGZILLA_AUTO_RESOLVE=true
# Close verified-fixed bugs but file nothing new
BUGZILLA_RESOLVE_ONLY=false

# ---- Runner (empty = sensible defaults for local vs CI)
HEADLESS=true
# Keep at 1 against real hosts: the QA accounts are shared and single-session, concurrent logins
# answer 500, and the probes trip rate limits. Parallelism needs an account pool (roadmap Phase 10).
WORKERS=
RETRIES=
# debug | info | warn | error
LOG_LEVEL=info
# pretty | json
LOG_FORMAT=pretty
CI=
BUILD_ID=
GITHUB_RUN_NUMBER=
