{
  "comment": [
    "THE authoritative registry of named run profiles (Phase 2 §17.1).",
    "Data, not code, so the TypeScript framework and the CJS runner (scripts/bench.cjs) read the",
    "SAME definitions instead of each keeping its own copy. Validated by a zod schema at startup",
    "(src/config/run-profiles.ts) — a malformed profile fails the run immediately with the path to",
    "the offending field.",
    "Each profile reproduces exactly what its package.json command already sets; the legacy commands",
    "are unchanged and a framework guard fails if the two ever drift.",
    "Fields:",
    "  targetKind   offline = no host and no mock | mock = bundled mock server | test = configured KPost test hosts",
    "  projects     Playwright projects to run (must include a dependency project such as 'setup')",
    "  grep         tag filter applied to the run",
    "  testFilter   positional Playwright file filter",
    "  flags        environment this mode sets; NEVER a secret, NEVER a host",
    "  lifecycles   gated write flows this mode opens",
    "  execution    mode + maxWorkers (the PROVEN ceiling; the default is always 1)",
    "  accounts     what the mode needs from the account inventory — DECLARATIVE ONLY in Phase 2.1;",
    "               the account pool that consumes it is a later step (§17.3)",
    "  cleanup      what removes this mode's data today: not-applicable | spec-managed",
    "  filing       never | command-armed (only `--file`) | resolve-only"
  ],
  "profiles": {
    "framework": {
      "description": "The bench's own guards. No network, no accounts.",
      "targetKind": "offline",
      "projects": ["framework"],
      "flags": {},
      "lifecycles": [],
      "execution": { "mode": "parallel-safe", "maxWorkers": 8 },
      "accounts": { "sessionPerWorker": 0, "businessKeys": [] },
      "cleanup": "not-applicable",
      "filing": "never"
    },
    "mock": {
      "description": "Every project against the bundled mock API.",
      "targetKind": "mock",
      "projects": ["setup", "api", "framework", "integration", "chromium"],
      "flags": { "MOCK_API": "true" },
      "lifecycles": [],
      "execution": { "mode": "parallel-safe", "maxWorkers": 4 },
      "accounts": { "sessionPerWorker": 0, "businessKeys": [] },
      "cleanup": "not-applicable",
      "filing": "never"
    },
    "kpost": {
      "description": "KPost API — all test types on the test DB + the write lifecycles.",
      "targetKind": "test",
      "projects": ["api"],
      "grep": "@kpost-api",
      "validationProfile": "FULL",
      "flags": { "MOCK_API": "false", "TEST_DB_MODE": "true", "OTP_TEST_GATEWAY": "true" },
      "lifecycles": [
        "KATCHUP_LIFECYCLE",
        "KALL_LIFECYCLE",
        "PROFILE_LIFECYCLE",
        "CONTACTS_LIFECYCLE",
        "GROUP_LIFECYCLE",
        "SETTINGS_LIFECYCLE",
        "KDIARY_LIFECYCLE",
        "KOS_LIFECYCLE",
        "AWS_LIFECYCLE"
      ],
      "execution": { "mode": "sequential", "maxWorkers": 1 },
      "accounts": { "sessionPerWorker": 4, "businessKeys": [] },
      "cleanup": "spec-managed",
      "filing": "command-armed"
    },
    "kpost-deep": {
      "description": "KPost API + write-fuzzing on data writes. Disposable test DB only — persists junk.",
      "targetKind": "test",
      "requiresDisposableTarget": true,
      "projects": ["api"],
      "grep": "@kpost-api",
      "validationProfile": "FULL",
      "flags": {
        "MOCK_API": "false",
        "TEST_DB_MODE": "true",
        "OTP_TEST_GATEWAY": "true",
        "WRITE_FUZZ": "true",
        "ALLOW_DESTRUCTIVE_TESTS": "true"
      },
      "lifecycles": [
        "KATCHUP_LIFECYCLE",
        "KALL_LIFECYCLE",
        "PROFILE_LIFECYCLE",
        "CONTACTS_LIFECYCLE",
        "GROUP_LIFECYCLE",
        "SETTINGS_LIFECYCLE",
        "KDIARY_LIFECYCLE",
        "KOS_LIFECYCLE",
        "AWS_LIFECYCLE"
      ],
      "execution": { "mode": "sequential", "maxWorkers": 1 },
      "accounts": { "sessionPerWorker": 4, "businessKeys": [] },
      "cleanup": "spec-managed",
      "filing": "command-armed"
    },
    "kmail": {
