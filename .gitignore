# Dependencies
node_modules/

# Playwright output — traces record request headers and bodies (bearer tokens, login passwords),
# so every output folder variant stays out of git, including per-project ones like *-admin.
/test-results*/
/playwright-report*/
/blob-report/
/playwright/.cache/
/reports/
/junit-report/

# Saved auth sessions (contain live cookies/tokens)
/.auth/

# Contract-pipeline intermediates: `npm run contract:excel` writes them, the coverage and gap
# audits read them. Regenerated, never reviewed, so not tracked.
/contracts/_*.json

# Mutable diagnostic-tool state (snapshot/diff accounts for the write-fuzz workflows) — generated
# working data, not source; see tests/framework/_snapshot-accounts.local.spec.ts.
*.local.json

# Environment files (secrets) — only the example is committed
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
*.log
